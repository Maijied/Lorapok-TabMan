# Firebase Configuration
# Copy this file to .env and fill in your values from the Firebase Console:
# Project Settings → General → Your apps → Web app → SDK setup and configuration

VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_DATABASE_ID="(default)"

# Extension publish flag
# 0 = build ZIP + GitHub Release only (no AMO signing, no version bump commit)
# 1 = full publish: bump version, build ZIP, GitHub Release, sign with AMO, commit version bump
PUBLISH_TO_AMO="0"
