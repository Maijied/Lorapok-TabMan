{
  "manifest_version": 3,
  "name": "Lorapok Tabman",
  "version": "1.0.0",
  "description": "Reduce memory usage and reclaim your focus by collapsing all open tabs into a single list.",
  "author": "Mohammad Maizied Hasan Majumder",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "notifications"
  ],
  "action": {
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Collapse Tabs to Lorapok Tabman"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabman@lorapok.com",
      "strict_min_version": "109.0"
    }
  }
}
