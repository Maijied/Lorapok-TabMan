{
  "manifest_version": 2,
  "name": "Lorapok TabMan",
  "version": "1.0.13",
  "description": "Reduce memory usage and reclaim your focus by collapsing all open tabs into a single, searchable dashboard.",
  "author": "Mohammad Maizied Hasan Majumder",
  "developer": {
    "name": "Mohammad Maizied Hasan Majumder",
    "url": "https://lorapok.github.io"
  },
  "homepage_url": "https://maijied.github.io/Lorapok-TabMan/",
  "browser_specific_settings": {
    "gecko": {
      "id": "tabman@lorapok.com",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Collapse Tabs — Lorapok TabMan"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "notifications",
    "alarms"
  ]
}
