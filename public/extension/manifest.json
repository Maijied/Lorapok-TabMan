{
  "manifest_version": 3,
  "name": "Lorapok TabMan",
  "version": "1.0.5",
  "description": "Reduce memory usage and reclaim your focus by collapsing all open tabs into a single list.",
  "author": "Mohammad Maizied Hasan Majumder",
  "license": "Apache-2.0",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "notifications",
    "alarms"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Collapse Tabs to Lorapok TabMan"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabman@lorapok.com",
      "strict_min_version": "109.0"
    }
  }
}
